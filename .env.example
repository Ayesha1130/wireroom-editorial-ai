# Every one of these is optional. With none set, Wireroom runs fully in
# demo mode: deterministic mock content, mock sources, no database writes —
# but the exact same orchestration code path as live mode.

# --- LLM --------------------------------------------------------------
# Without this, lib/llm.ts uses MockLLMClient (deterministic, no network).
OPENAI_API_KEY=

# --- Search (research agent) --------------------------------------------
# Without this, lib/search.ts uses MockSearchProvider (labeled demo sources).
# Get a key at https://tavily.com — it's built for feeding LLM agents.
TAVILY_API_KEY=

# --- Persistence (Supabase) ----------------------------------------------
# Without these, /api/dispatches acknowledges publishes but persists nothing.
# SUPABASE_URL is your project URL. SUPABASE_SERVICE_ROLE_KEY is the
# service-role key from Project Settings > API — NEVER the anon key, and
# NEVER prefixed with NEXT_PUBLIC_. It is used only in server-side API
# routes (lib/supabase.ts is marked "server-only" and will throw if
# accidentally imported into client code).
SUPABASE_URL=

SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# demo = no API keys required
# live = uses OpenAI + Tavily
LLM_MODE=demo
SEARCH_MODE=demo